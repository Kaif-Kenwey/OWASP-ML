# ---- AI Analyst (optional) ----
# Without a key the project falls back to a rule-based summary engine,
# so everything (including demo mode) still works offline.
#
# Any OpenAI-compatible provider works:
#   OpenAI:    https://api.openai.com/v1
#   Groq:      https://api.groq.com/openai/v1        (free tier available)
#   OpenRouter: https://openrouter.ai/api/v1
#   Local LLM: http://localhost:11434/v1 (e.g. Ollama)

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- OWASP ZAP ----
# Address of your running ZAP proxy
ZAP_API=http://127.0.0.1:8080
# API key configured in ZAP (Tools > Options > API) — required by modern ZAP
ZAP_API_KEY=
